{
  "version": "1.4.0-llm",
  "seed_bank": "data/seeds.json",
  "canon": "knowledge/visual_language.json",
  "worlds": "knowledge/worlds.json",
  "mining": "knowledge/mining.md",
  "characters": "knowledge/characters/milo2/canon.json",
  "anchors": "knowledge/anchors/registry.json",

  "provider": "deepseek_cdp",

  "ds": {
    "cdp": "http://127.0.0.1:9222",
    "url": "https://chat.deepseek.com/",
    "selector": "textarea.ds-scroll-area",
    "assistant_selector": "[class*=assistant], [data-message-author-role=assistant]",
    "max_parallel_tabs": 5,
    "poll_s": 2.5,
    "stable_reads": 2,
    "response_timeout_s": 300,
    "read_back_required": true,
    "max_json_retry": 2
  },

  "timeout_s": 2700,
  "max_revisions": 3,
  "words_per_second_estimate": 2.3,
  "max_duration_s": 45,
  "min_creative_score": 90,
  "min_milo_score": 90,
  "max_shot_s": 3.0,
  "first_shot_exception": true,
  "music": false,
  "sfx": false,
  "max_judge_disagreement": 8,

  "script_parallel_agents": 5,
  "min_review_passes": 1,
  "second_review_mode": "conditional",
  "specialist_max_bytes": 6000,
  "seed_bank_format": "production-compact-2.1.0"
}