{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "reviews"
  ],
  "properties": {
    "reviews": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "role",
          "candidate_hash",
          "dimensions",
          "perspectives",
          "critical_errors",
          "novelty_checked_against_history",
          "review_id",
          "rubric_version",
          "confidence",
          "canon_comparison",
          "mining_comparison",
          "history_comparison"
        ],
        "properties": {
          "role": {
            "const": "independent_critic"
          },
          "candidate_hash": {
            "type": "string"
          },
          "dimensions": {
            "type": "object",
            "required": [
              "hook",
              "narrative",
              "emotion",
              "visual",
              "voice",
              "editing",
              "shareability",
              "milo"
            ]
          },
          "critical_errors": {
            "type": "array"
          },
          "novelty_checked_against_history": {
            "const": true
          }
        }
      }
    }
  }
}