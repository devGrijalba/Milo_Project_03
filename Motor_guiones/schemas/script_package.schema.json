{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Milo Script Package v1",
  "type": "object",
  "required": [
    "episode_id",
    "seed_id",
    "bank_version",
    "seed_hash",
    "title",
    "central_conflict",
    "payoff",
    "share_recipient",
    "novelty_justification",
    "selected_hook_id",
    "seed_snapshot",
    "hooks",
    "music",
    "sfx",
    "beats"
  ],
  "properties": {
    "episode_id": {
      "type": "string",
      "minLength": 1
    },
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "bank_version": {
      "type": "string",
      "minLength": 1
    },
    "seed_hash": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "central_conflict": {
      "type": "string",
      "minLength": 1
    },
    "payoff": {
      "type": "string",
      "minLength": 1
    },
    "share_recipient": {
      "type": "string",
      "minLength": 1
    },
    "novelty_justification": {
      "type": "string",
      "minLength": 1
    },
    "selected_hook_id": {
      "type": "string",
      "minLength": 1
    },
    "seed_snapshot": {
      "type": "object"
    },
    "hooks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "id",
          "text",
          "reason"
        ]
      }
    },
    "music": {
      "const": false
    },
    "sfx": {
      "const": false
    },
    "beats": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "beat_id",
          "function",
          "narration",
          "new_information",
          "visual_action",
          "narration_visual_link",
          "characters",
          "world_id",
          "voice_intention",
          "pause_after_s",
          "text_emphasis",
          "shot",
          "transition",
          "director_direction",
          "director_voice_text"
        ],
        "properties": {
          "narration": {
            "type": "string",
            "minLength": 1
          },
          "pause_after_s": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "characters": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "shot": {
            "type": "object",
            "required": [
              "scale",
              "motion",
              "motion_reason",
              "continuity",
              "subtitle_safe_top"
            ],
            "properties": {
              "subtitle_safe_top": {
                "const": true
              }
            }
          },
          "transition": {
            "type": "object",
            "required": [
              "type",
              "duration_s",
              "reason"
            ],
            "properties": {
              "duration_s": {
                "type": "number",
                "minimum": 0,
                "maximum": 0.6
              }
            }
          },
          "director_voice_text": {
            "type": "string",
            "minLength": 1
          },
          "director_direction": {
            "type": "object",
            "required": [
              "viewer_emotion",
              "narrator_intention",
              "emotional_entry",
              "emotional_exit",
              "emphasis",
              "pause_reason",
              "visual_sync",
              "forbidden_delivery"
            ],
            "properties": {
              "viewer_emotion": {
                "type": "string",
                "minLength": 1
              },
              "narrator_intention": {
                "type": "string",
                "minLength": 1
              },
              "emotional_entry": {
                "type": "string",
                "minLength": 1
              },
              "emotional_exit": {
                "type": "string",
                "minLength": 1
              },
              "emphasis": {
                "type": "string",
                "minLength": 1
              },
              "pause_reason": {
                "type": "string",
                "minLength": 1
              },
              "visual_sync": {
                "type": "string",
                "minLength": 1
              },
              "forbidden_delivery": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}